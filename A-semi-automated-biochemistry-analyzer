import json
import os
import random
import time

class BiochemistryAnalyzer:
    def __init__(self, filename="biochem_results.json"):
        self.filename = filename
        self.results = []
        self.tests = {
            "Glucose": {"calibration_factor": 0.005, "range": (70, 110), "unit": "mg/dL"},
            "Cholesterol": {"calibration_factor": 0.002, "range": (120, 200), "unit": "mg/dL"},
            "Urea": {"calibration_factor": 0.01, "range": (7, 20), "unit": "mg/dL"}
        }
        self.load_results()

    def load_results(self):
        """Load previous results from JSON file."""
        if os.path.exists(self.filename):
            try:
                with open(self.filename, 'r') as file:
                    self.results = json.load(file)
            except json.JSONDecodeError:
                print("Error loading results. Starting with an empty database.")
                self.results = []
        else:
            print("No results file found. Starting with an empty database.")

    def save_results(self):
        """Save results to JSON file."""
        try:
            with open(self.filename, 'w') as file:
                json.dump(self.results, file, indent=4)
            print("Results saved successfully.")
        except Exception as e:
            print(f"Error saving results: {e}")

    def simulate_absorbance(self):
        """Simulate absorbance reading from a photometer."""
        # Absorbance typically ranges from 0.1 to 2.0 in biochemical assays
        return random.uniform(0.1, 2.0)

    def calculate_concentration(self, absorbance, test_name):
        """Calculate analyte concentration using calibration factor."""
        calibration_factor = self.tests[test_name]["calibration_factor"]
        concentration = absorbance / calibration_factor
        return round(concentration, 2)

    def interpret_result(self, test_name, concentration):
        """Interpret result based on reference range."""
        low, high = self.tests[test_name]["range"]
        if concentration < low:
            return "Low"
        elif concentration > high:
            return "High"
        return "Normal"

    def run_test(self, patient_id, test_name):
        """Run a simulated biochemical test."""
        if test_name not in self.tests:
            print(f"Test '{test_name}' not available. Available tests: {list(self.tests.keys())}")
            return

        print(f"\nRunning {test_name} test for Patient ID: {patient_id}")
        print("Please load sample and reagent into cuvette (manual step)...")
        time.sleep(2)  # Simulate manual sample preparation

        absorbance = float(input("Enter absorbance reading (or press Enter to simulate): ") or self.simulate_absorbance())
        print(f"Absorbance: {absorbance:.2f}")

        concentration = self.calculate_concentration(absorbance, test_name)
        status = self.interpret_result(test_name, concentration)

        result = {
            "patient_id": patient_id,
            "test_name": test_name,
            "absorbance": absorbance,
            "concentration": concentration,
            "unit": self.tests[test_name]["unit"],
            "status": status,
            "timestamp": time.strftime("%Y-%m-%d %H:%M:%S")
        }
        self.results.append(result)
        self.save_results()

        print("\n--- Test Results ---")
        print(f"Patient ID: {patient_id}")
        print(f"Test: {test_name}")
        print(f"Absorbance: {absorbance:.2f}")
        print(f"Concentration: {concentration} {self.tests[test_name]['unit']}")
        print(f"Status: {status} (Reference Range: {self.tests[test_name]['range'][0]}–{self.tests[test_name]['range'][1]} {self.tests[test_name]['unit']})")
        print("------------------")

    def view_results(self):
        """Display all test results."""
        if not self.results:
            print("No test results available.")
            return
        print("\n--- All Test Results ---")
        for result in self.results:
            print(f"Patient ID: {result['patient_id']}, Test: {result['test_name']}, "
                  f"Concentration: {result['concentration']} {result['unit']}, "
                  f"Status: {result['status']}, Time: {result['timestamp']}")
        print("-----------------------")


